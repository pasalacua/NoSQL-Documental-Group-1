# Copiá este archivo como .env y completá los valores.

# Cadena de conexión a MongoDB.
#   Local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# Nombre de la base de datos que usa el juego.
MONGO_DB_NAME=pokelab

# Clave para firmar la sesión de cada investigador (poné cualquier texto largo y secreto).
SECRET_KEY=cambiar-por-un-texto-largo-y-secreto

# PIN del panel del expositor (/panel).
PANEL_PIN=1234

# Servidor: 0.0.0.0 permite que entren los celulares de la misma red Wi-Fi.
HOST=0.0.0.0
PORT=5000
